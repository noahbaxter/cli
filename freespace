#!/usr/bin/env python3
"""Scan for disk space bloat on macOS dev machines. Reports what's taking space — never deletes anything."""

import argparse
import concurrent.futures
import json
import os
import shutil
import sys
from collections import defaultdict
from dataclasses import dataclass, field
from enum import Enum


# ── Data Model ──────────────────────────────────────────────────────────────────


class Category(Enum):
    PACKAGE_CACHES = "Package Caches"
    BUILD_ARTIFACTS = "Build Artifacts"
    APP_CACHES = "App Caches"
    DOWNLOADS = "Downloads & Media"
    CONTAINERS = "Containers"
    LOGS = "Logs"
    LARGE_FILES = "Large Files"


class Safety(Enum):
    SAFE = "safe"
    MODERATE = "moderate"
    RISKY = "risky"


@dataclass
class BloatTarget:
    name: str
    path: str
    category: Category
    safety: Safety
    scan_children: bool = False
    child_pattern: str = ""
    max_depth: int = 3
    scan_bases: list[str] = field(default_factory=list)
    breakdown: bool = False  # show top children ranked by size
    breakdown_limit: int = 10


@dataclass
class ScanResult:
    name: str
    path: str
    category: Category
    safety: Safety
    size_bytes: int
    count: int = 1
    note: str = ""
    children: list["ScanResult"] = field(default_factory=list)


